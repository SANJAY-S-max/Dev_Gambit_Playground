# ============================================================
# Dev_Gambit_Playground — .gitignore
# Covers: Java/Maven, JSP/Servlet, Eclipse IDE, Tomcat, MERN Stack
# ============================================================


# --- Eclipse IDE ---------------------------------------------
.metadata/
.classpath
.project
.settings/
*.launch
*.bak
*.tmp
*.swp
RemoteSystemsTempFiles/
.recommenders/


# --- Maven Build Artifacts -----------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar


# --- NetBeans IDE --------------------------------------------
nbproject/private/
nbproject/Makefile-*.mk
nbproject/Package-*.bash
build/
nbbuild/
dist/
nbdist/
.nb-gradle/


# --- IntelliJ IDEA -------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/


# --- Tomcat Binary Installation ------------------------------
tomcat/apache-tomcat-*-windows-x64/


# --- MERN Stack — Node.js ------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm
package-lock.json
yarn.lock


# --- MERN Stack — React Build --------------------------------
MERN_Stack/**/build/
MERN_Stack/**/dist/
MERN_Stack/**/.cache/


# --- Environment Variables -----------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local


# --- MongoDB / Database --------------------------------------
*.db
*.sqlite
data/db/


# --- OS Generated Files --------------------------------------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db


# --- Logs ----------------------------------------------------
*.log
logs/


# --- Compiled Source -----------------------------------------
*.class
*.com
*.pyc
*.o
*.so
